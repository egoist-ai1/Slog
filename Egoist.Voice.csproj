<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants Condition="'$(VoiceFlavor)' == 'Compact'">$(DefineConstants);COMPACT_PORTABLE</DefineConstants>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;build/**</DefaultItemExcludes>
    <ApplicationIcon>assets\EgoistVoice.ico</ApplicationIcon>
    <!--
      DPI awareness is declared in app.manifest, not here. ApplicationHighDpiMode only takes
      effect through ApplicationConfiguration.Initialize(), which a WPF entry point never calls,
      so this property silently did nothing while the process ran system-DPI-aware.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFAC010 asks WinForms projects to move DPI configuration out of the manifest. This is a WPF
      application that only borrows WinForms for the tray icon: there is no
      ApplicationConfiguration.Initialize() to honour the property, so the manifest is the only
      declaration that actually reaches the process.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>Egoist.Voice</AssemblyName>
    <RootNamespace>Egoist.Voice</RootNamespace>
    <Version>3.0.1</Version>
    <AssemblyVersion>3.0.1.0</AssemblyVersion>
    <FileVersion>3.0.1.0</FileVersion>
    <Company>EGOIST</Company>
    <Product>Egoist Voice</Product>
    <Description>Быстрая локальная русская диктовка для Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="vendor\sherpa-managed-utf8\1.13.4\Egoist.Sherpa.Onnx.Utf8.csproj" />
    <Content Include="vendor\sherpa-managed-utf8\1.13.4\LICENSE" Link="licenses\sherpa-managed-utf8-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\sherpa-managed-utf8\1.13.4\source-manifest.json" Link="licenses\sherpa-managed-utf8-source-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\sherpa-managed-utf8\1.13.4\utf8-binding.patch" Link="licenses\sherpa-managed-utf8.patch" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.4" ExcludeAssets="runtime;native" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.9.1" Condition="'$(VoiceFlavor)' != 'Compact'" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EV-2206 deliberately consumes a hash-pinned net8 client artifact. Voice
      remains independently buildable and never references the Translator
      sibling source tree or a floating package feed.
    -->
    <Reference Include="Egoist.Translation.Contracts">
      <HintPath>vendor\translation-client\1.0.0\net8.0\Egoist.Translation.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Egoist.Translation.Client">
      <HintPath>vendor\translation-client\1.0.0\net8.0\Egoist.Translation.Client.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="vendor\translation-client\1.0.0\manifest.json"
             Link="translation-client\manifest.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="vendor\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="installer\EgoistVoiceBootstrap.cs" />
    <Compile Remove="installer\EgoistVoiceWebBootstrap.cs" />
    <Compile Remove="installer\EgoistVoiceWebBootstrap.Manifest.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Трей грузит иконку из assets\EgoistVoice.ico рядом с исполняемым файлом и лишь при её
      отсутствии выковыривает встроенную из exe. Без этой копии первая ветка была мёртвой:
      файла в выходном каталоге не оказывалось никогда.
    -->
    <Content Include="assets\EgoistVoice.ico" Link="assets\EgoistVoice.ico"
             CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="assets\EgoistVoice.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="vendor\sherpa-native-asr\1.13.4\sherpa-onnx-c-api.dll" Link="sherpa-onnx-c-api.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)org.k2fsa.sherpa.onnx.runtime.win-x64/1.13.4/runtimes/win-x64/native/onnxruntime.dll" Link="onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="vendor\sherpa-native-asr\1.13.4\manifest.json" Link="licenses\native-asr\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\sherpa-native-asr\1.13.4\licenses\*" Link="licenses\native-asr\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyPinnedNativeAsr" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_PinnedNative Include="$(MSBuildProjectDirectory)/vendor/sherpa-native-asr/1.13.4/sherpa-onnx-c-api.dll">
        <ExpectedHash>dcfc89cf50fbd0fb77c115a6b53ee9b2739e57d6d1f4158a3aeab31dd7139676</ExpectedHash>
      </_PinnedNative>
      <_PinnedNative Include="$(NuGetPackageRoot)org.k2fsa.sherpa.onnx.runtime.win-x64/1.13.4/runtimes/win-x64/native/onnxruntime.dll">
        <ExpectedHash>daa77083a45bf525da0dde9e87f85d8eb146f58f9c9aa7124ca84545e1c0f148</ExpectedHash>
      </_PinnedNative>
    </ItemGroup>
    <GetFileHash Files="@(_PinnedNative)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_PinnedNativeHash" />
    </GetFileHash>
    <Error Condition="'%(_PinnedNativeHash.FileHash)' != '%(_PinnedNativeHash.ExpectedHash)'" Text="Pinned native ASR hash mismatch: %(_PinnedNativeHash.Identity)" />
  </Target>

</Project>
